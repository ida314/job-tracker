# state / data — machine-authored, never committed
data/
*.db
*.db-wal
*.db-shm

# personal data — curated like criteria.yaml, but never committed. answers.yaml holds
# your name, email, phone, and whatever else an application form has asked for;
# answers.example.yaml is the tracked file that documents its shape.
answers.yaml
answers.yaml.bak
answers.yaml.candidate
resume.pdf
resume*.pdf
cover-letter*.pdf

# import plugins — which feeds you switched on and where they point. Personal config,
# like answers.yaml: plugins.example.yaml is the tracked file that documents the shape.
# The bot token is NOT in here; it is $JOBTRACKER_DISCORD_TOKEN. See docs/plugins.md.
plugins.yaml
plugins.yaml.bak
plugins.yaml.candidate

# safe-write leftovers from an interrupted criteria edit
criteria.yaml.bak
criteria.yaml.candidate

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
